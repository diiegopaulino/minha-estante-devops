# Copie para terraform.tfvars e ajuste os valores.
# Valores abaixo prontos para o AWS Academy (Learner Lab).
aws_region    = "us-east-1"
project_name  = "minha-estante"
environment   = "prod"
instance_type = "t3.micro"

# Os runners do GitHub Actions usam IPs variáveis, então o SSH precisa aceitar
# qualquer origem para o deploy automático. O acesso continua protegido por chave.
# Sem deploy pelo pipeline, prefira restringir ao seu IP: "SEU.IP.PUBLICO/32".
ssh_allowed_cidr = "0.0.0.0/0"

# Key pair que já existe no AWS Academy (a chave é o labsuser.pem).
key_pair_name = "vockey"
